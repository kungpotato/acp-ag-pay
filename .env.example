# Optional: enables LLM-backed intent parsing via OpenRouter (Lesson 2).
# Without this set, the shopping agent falls back to a deterministic
# rule-based parser automatically — no functionality is lost.
OPENROUTER_API_KEY=

# Required from Lesson 5 onward: Stripe TEST MODE secret key (sk_test_...).
# Without this set, /api/agent/pay returns a clear 503 error instead of
# calling Stripe — no crash, no functionality lost outside settlement.
STRIPE_SECRET_KEY=

# Required from Lesson 7 onward: get this by running
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# which prints a whsec_... value. Without this, the webhook route
# returns 503 and orders stay stuck at pending_confirmation.
STRIPE_WEBHOOK_SECRET=
